    "version": "0.2.0",
    "configurations": [
    
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "ConsoleAppReport",
            "request": "launch",
            "mainClass": "main.ConsoleAppReport",
            "projectName": "sdp2"
        },
        {
            "type": "java",
            "name": "MainApp",
            "request": "launch",
            "mainClass": "main.MainApp",
            "vmArgs": "--module-path \"${workspaceFolder}/javafx-sdk-21.0.10/lib\" --add-modules javafx.controls,javafx.fxml",
            "projectName": "sdp2"
        },
        {
            "type": "java",
            "name": "MockMain",
            "request": "launch",
            "mainClass": "main.MockMain",
            "projectName": "sdp2"
        },
        {
            "type": "java",
            "name": "populateDb",
            "request": "launch",
            "mainClass": "main.populateDb",
            "projectName": "sdp2"
        }
    ]
}