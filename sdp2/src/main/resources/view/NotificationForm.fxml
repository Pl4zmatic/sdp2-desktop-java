<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootLayout" styleClass="root" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NotificationFormController">
   <center>
      <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
         <children>
            <ScrollPane fitToWidth="true" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
               <content>
                  <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox fx:id="contentVBox" maxWidth="500.0" prefWidth="500.0" spacing="15.0" styleClass="formContainer">
                           <children>
                              <HBox styleClass="headerContainer">
                                 <children>
                                    <Label fx:id="formTitle" styleClass="headerText" text="Notification Form">
                                       <font>
                                          <Font size="24.0" />
                                       </font>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets bottom="15.0" top="5.0" />
                                 </padding>
                              </HBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                                       <children>
                                          <Label styleClass="fieldLabel" text="Title" />
                                          <Label styleClass="required" text="*" />
                                       </children>
                                    </HBox>
                                    <TextField fx:id="title" styleClass="inputField" />
                                 </children>
                              </VBox>
                              <VBox layoutX="35.0" layoutY="97.0" spacing="6.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                                       <children>
                                          <Label styleClass="fieldLabel" text="Message" />
                                          <Label styleClass="required" text="*" />
                                       </children>
                                    </HBox>
                                    <TextArea fx:id="messageTextArea" prefHeight="150.0" styleClass="inputField" />
                                 </children>
                              </VBox>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                                       <children>
                                          <Label styleClass="fieldLabel" text="Type:" />
                                          <Label styleClass="required" text="*" />
                                       </children>
                                    </HBox>
                                    <Pane HBox.hgrow="ALWAYS" />
                                    <HBox spacing="20.0">
                                       <children>
                                          <RadioButton fx:id="maintenance" mnemonicParsing="false" styleClass="radioButton" text="Maintenance">
                                             <toggleGroup>
                                                <ToggleGroup fx:id="toggleGroupType" />
                                             </toggleGroup>
                                          </RadioButton>
                                          <RadioButton fx:id="reminder" mnemonicParsing="false" styleClass="radioButton" text="Reminder" toggleGroup="$toggleGroupType" />
                                       </children>
                                    </HBox>
                                 </children>
                                 <VBox.margin>
                                    <Insets top="5.0" />
                                 </VBox.margin>
                              </HBox>
                              <VBox layoutX="35.0" layoutY="174.0" spacing="6.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                                       <children>
                                          <Label styleClass="fieldLabel" text="People" />
                                          <Label styleClass="required" text="*" />
                                       </children>
                                    </HBox>
                                    <VBox spacing="5.0">
                                       <children>
                                          <ComboBox fx:id="comboBoxPeople" editable="true" prefWidth="150.0" />
                                          <ScrollPane vbarPolicy="NEVER">
                                             <content>
                                                <HBox fx:id="hboxSelectedPeople" spacing="5.0" />
                                             </content>
                                          </ScrollPane>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                 <children>
                                    <Button fx:id="cancel" mnemonicParsing="false" styleClass="cancelButton" text="Cancel" />
                                    <Button fx:id="save" mnemonicParsing="false" styleClass="primaryButton" text="Add" />
                                 </children>
                                 <VBox.margin>
                                    <Insets top="15.0" />
                                 </VBox.margin>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/form.css" />
   </stylesheets>
</BorderPane>
