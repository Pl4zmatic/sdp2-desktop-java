<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootLayout" prefHeight="600.0" prefWidth="800.0" styleClass="root" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NotificationViewController">
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/ViewNotifications.css" />
   </stylesheets>
   <center>
      <VBox alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="contentVBox" maxWidth="1178.0" prefHeight="940.0" prefWidth="1099.0" spacing="15.0" styleClass="formContainer">
               <children>
                  <HBox styleClass="headerContainer">
                     <children>
                        <Label fx:id="formTitle" styleClass="headerText" text="Notifications">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="15.0" top="5.0" />
                     </padding>
                  </HBox>
                  <ScrollPane fx:id="notificationScrollable" fitToWidth="true" prefHeight="500.0" prefWidth="710.0" styleClass="edge-to-edge">
                     <content>
                        <VBox fx:id="notificationVbox" />
                     </content>
                  </ScrollPane>
               </children>
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
