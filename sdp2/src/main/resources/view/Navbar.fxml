            <VBox fx:id="menuItem1">
               <children>
                  <Button fx:id="btnMenu1" styleClass="menuItem" stylesheets="@../css/LandingPage.css" text="▸ Administrator">
                     <font>
                        <Font name="Inter Medium" size="12.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <VBox fx:id="subMenu1">
                     <children>
                        <Button styleClass="subMenuItem" stylesheets="@../css/LandingPage.css" text="Beheer Gebruikers">
                           <VBox.margin>
                              <Insets left="30.0" />
                           </VBox.margin>
                           <font>
                              <Font name="Inter Medium" size="12.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Button styleClass="subMenuItem" stylesheets="@../css/LandingPage.css" text="Logs">
                           <VBox.margin>
                              <Insets left="30.0" />
