                           <VBox.margin>
                              <Insets left="30.0" />
                           </VBox.margin>
                           <font>
                              <Font name="Inter Medium" size="12.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Button styleClass="subMenuItem" stylesheets="@../css/LandingPage.css" text="Beheer Notificaties">
                           <font>
                              <Font name="Inter Medium" size="12.0" />
