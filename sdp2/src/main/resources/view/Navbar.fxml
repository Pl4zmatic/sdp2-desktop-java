                  <VBox fx:id="subMenu3">
                     <children>
                        <Button styleClass="subMenuItem" stylesheets="@../css/LandingPage.css" text="Onderhoud">
                           <VBox.margin>
                              <Insets left="30.0" />
                           </VBox.margin>
                           <font>
                              <Font name="Inter Medium" size="12.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="290.0" spacing="50.0">
         <children>
            <Text fill="#3b3535" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="profileText" text="Notifications">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <font>
