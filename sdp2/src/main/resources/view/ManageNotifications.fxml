<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootLayout" prefHeight="720.0" prefWidth="1200.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageNotificationsController">
   <center>
      <VBox alignment="CENTER" fillWidth="false" spacing="15.0" styleClass="content-container" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="searchBarContainer" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefHeight="85.0" spacing="20.0" styleClass="search-bar">
               <children>
                  <ComboBox fx:id="typeFilterComboBox" prefHeight="40.0" prefWidth="200.0" promptText="Filter on type" styleClass="filter-combo" />
                  <TextField fx:id="searchBar" prefHeight="40.0" prefWidth="300.0" promptText="Search notifications..." styleClass="search-field" />
                  <Button fx:id="addButton" contentDisplay="CENTER" prefWidth="60.0" styleClass="add-button" text="+">
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" top="15.0" />
               </padding>
            </HBox>
            <TableView fx:id="tableView" prefHeight="550.0" styleClass="table" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets left="15.0" right="15.0" />
               </VBox.margin>
            </TableView>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </center>
   <right>
      <StackPane fx:id="rightPanelContainer" managed="false" prefWidth="400.0" styleClass="right-panel-container" visible="false">
         <!-- MachineForm zal hier dynamisch worden toegevoegd -->
      </StackPane>
   </right>
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/table.css" />
   </stylesheets>
</BorderPane>
