<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<HBox fx:id="notificationItemHbox" prefHeight="50.0" prefWidth="725.0" style="-fx-border-color: #EF463C; -fx-border-radius: 10; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NotificationElement">
   <children>
      <BorderPane prefHeight="51.0" prefWidth="32.0">
         <center>
            <ImageView fx:id="notificationTypeImage" fitHeight="56.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER">
               <image>
                  <Image url="@../images/maintenance-icon-black.png" />
               </image>
               <BorderPane.margin>
                  <Insets left="5.0" />
               </BorderPane.margin>
            </ImageView>
         </center>
      </BorderPane>
      <Label id="title" fx:id="notificationTitleLabel" prefHeight="34.0" prefWidth="347.0" text="Onderhoud gepland" wrapText="true">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
         <HBox.margin>
            <Insets bottom="5.0" left="10.0" right="5.0" top="5.0" />
         </HBox.margin>
      </Label>
      <Label fx:id="notificationDateLabel" prefHeight="44.0" prefWidth="85.0" text="12/12/2025" wrapText="true">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Label fx:id="notificationStatusLabel" prefHeight="44.0" prefWidth="89.0" text="Nieuw" textFill="#ff0e00">
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin>
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Region prefHeight="44.0" prefWidth="110.0" HBox.hgrow="ALWAYS" />
      <Button fx:id="notificationDeleteButton" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" prefHeight="72.0" prefWidth="40.0" styleClass="profileIcon" stylesheets="@../css/Navbar.css" textAlignment="CENTER">
         <graphic>
            <ImageView fx:id="notificationDeleteImage" fitHeight="48.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/trashcan-icon.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
   </children>
</HBox>
