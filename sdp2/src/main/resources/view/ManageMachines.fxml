<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXTableView?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootLayout" prefHeight="720.0" prefWidth="1000.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageMachinesController">
   <center>
      <VBox alignment="CENTER" spacing="15.0" styleClass="content-container" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <HBox fx:id="searchBarContainer" alignment="CENTER_RIGHT" prefHeight="85.0" spacing="20.0" styleClass="search-bar">
                     <children>
                        <VBox alignment="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="deleted-users-container">
                           <children>
                              <Label styleClass="deleted-users-label" text="Deleted Machines" />
                              <CheckBox fx:id="showDeletedMachines" mnemonicParsing="false" styleClass="deleted-users-checkbox" />
                           </children>
                        </VBox>
                        <TextField fx:id="searchBar" prefHeight="40.0" prefWidth="300.0" promptText="Search machines..." styleClass="search-field" />
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
                  <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" styleClass="table-scroll-pane" VBox.vgrow="ALWAYS">
                     <content>
                        <HBox alignment="CENTER">
                           <children>
                              <MFXTableView fx:id="tableView" minWidth="900.0" prefHeight="550.0" styleClass="user-table" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                           </padding>
                        </HBox>
                     </content>
                  </ScrollPane>
                  <HBox fx:id="buttonContainer" alignment="CENTER">
                     <children>
                        <Button fx:id="addMachineButton" contentDisplay="CENTER" styleClass="add-machine-button" text="+">
                           <padding>
                              <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                           </padding>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="15.0" top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </center>
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/ManageMachines.css" />
   </stylesheets>
</BorderPane>

