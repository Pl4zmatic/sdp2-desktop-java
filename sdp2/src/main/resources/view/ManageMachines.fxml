<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootLayout" prefHeight="720.0" prefWidth="1200.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ManageMachinesController">
   <center>
      <VBox alignment="CENTER" fillWidth="false" spacing="15.0" styleClass="content-container" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="searchBarContainer" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefHeight="85.0" spacing="20.0" styleClass="search-bar">
               <children>
                  <VBox alignment="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="deleted-users-container">
                     <children>
                        <Label styleClass="deleted-users-label" text="Deleted Machines" />
                        <CheckBox fx:id="showDeletedMachines" mnemonicParsing="false" styleClass="deleted-users-checkbox" />
                     </children>
                  </VBox>
                  <ComboBox fx:id="locationFilterComboBox" prefHeight="40.0" prefWidth="200.0" promptText="Filter on location" styleClass="filter-combo" />
                  <TextField fx:id="searchBar" prefHeight="40.0" prefWidth="300.0" promptText="Search machines..." styleClass="search-field" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" top="15.0" />
               </padding>
            </HBox>
            <TableView fx:id="tableView" prefHeight="550.0" styleClass="user-table" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets left="15.0" right="15.0" />
               </VBox.margin>
            </TableView>
            <Button fx:id="addMachineButton" contentDisplay="CENTER" styleClass="add-machine-button" text="+">
               <VBox.margin>
                  <Insets bottom="15.0" top="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </Button>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </center>
   <right>
      <StackPane fx:id="rightPanelContainer" managed="false" prefWidth="400.0" styleClass="right-panel-container" visible="false">
         <!-- MachineForm zal hier dynamisch worden toegevoegd -->
      </StackPane>
   </right>
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/ManageMachines.css" />
   </stylesheets>
</BorderPane>
