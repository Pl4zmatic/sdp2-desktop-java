<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootLayout" prefHeight="720.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UserFormController">
   <center>
      <VBox maxWidth="500.0" prefWidth="500.0" spacing="20.0" styleClass="formContainer" BorderPane.alignment="CENTER">
         <children>
            <HBox styleClass="codeContainer">
               <children>
                  <Label fx:id="formTitle" text="User Form">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <VBox spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="First Name" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <TextField fx:id="firstNameField" />
               </children>
            </VBox>
            <VBox spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Last Name" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <TextField fx:id="lastNameField" />
               </children>
            </VBox>
            <VBox layoutX="20.0" layoutY="426.0" spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Email" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <TextField fx:id="emailField" />
               </children>
            </VBox>
            <VBox fx:id="passwordContainer" spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label fx:id="passwordLabel" text="Password" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <PasswordField fx:id="passwordField" />
               </children>
            </VBox>
            <!-- New Password Reset Container -->
            <HBox fx:id="passwordResetContainer" alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Reset Password:" />
                  <Button fx:id="resetPasswordButton" styleClass="reset-button" text="Reset to First Name" />
               </children>
            </HBox>
            <VBox spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Adress" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <TextField fx:id="adressField" />
               </children>
            </VBox>
            <VBox spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Phone Number" />
                        <Label fx:id="phoneRequiredLabel" styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <TextField fx:id="phoneNumberField" />
               </children>
            </VBox>
            <VBox spacing="1.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Role" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <ComboBox fx:id="roleField" prefHeight="25.0" prefWidth="200.0" />
               </children>
            </VBox>
            <HBox alignment="CENTER" layoutX="20.0" layoutY="480.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Status:" />
                        <Label styleClass="required" text="*" />
                     </children>
                  </HBox>
                  <Pane HBox.hgrow="ALWAYS" />
                  <HBox spacing="15.0">
                     <children>
                        <RadioButton fx:id="activeButton" mnemonicParsing="false" text="Actief" />
                        <RadioButton fx:id="inactiveButton" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" text="Inactief" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button fx:id="cancel" mnemonicParsing="false" onAction="#handleCancel" text="Annuleer" />
                  <Button fx:id="save" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleSaveUser" text="Voeg Toe" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/MachineForm.css" />
   </stylesheets>
</BorderPane>
