<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootLayout" prefHeight="720.0" prefWidth="1000.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GebruikersBeheerderController">
   <center>
      <VBox alignment="CENTER" fillWidth="false" spacing="15.0" styleClass="content-container" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="searchBarContainer" alignment="CENTER_RIGHT" prefHeight="85.0" spacing="20.0" styleClass="search-bar">
               <children>
                  <VBox alignment="CENTER" prefHeight="40.0" prefWidth="150.0" styleClass="deleted-users-container">
                     <children>
                        <Label styleClass="deleted-users-label" text="Deleted Users" />
                        <CheckBox fx:id="showDeletedUsers" mnemonicParsing="false" styleClass="deleted-users-checkbox" />
                     </children>
                  </VBox>
                  <ComboBox fx:id="RoleFilterComboBox" prefHeight="40.0" prefWidth="200.0" promptText="Filter on role" styleClass="filter-combo" />
                  <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="Search users..." styleClass="search-field" />
                  <Button fx:id="addUserButton" contentDisplay="CENTER" prefWidth="60.0" styleClass="add-user-button" text="+">
                     <padding>
                        <Insets bottom="10.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" top="15.0" />
               </padding>
            </HBox>
            <TableView fx:id="userTable" prefHeight="550.0" styleClass="user-table" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets left="15.0" right="15.0" />
               </VBox.margin>
            </TableView>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </center>
   <right>
      <StackPane fx:id="rightPanelContainer" alignment="CENTER" managed="false" prefWidth="400" visible="false" />
   </right>
   <stylesheets>
      <URL value="@../css/globals.css" />
      <URL value="@../css/ManageUsers.css" />
   </stylesheets>
</BorderPane>
