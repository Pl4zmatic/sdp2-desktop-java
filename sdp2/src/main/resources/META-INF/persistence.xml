<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="shopfloor" transaction-type="RESOURCE_LOCAL">
        <!-- EclipseLink als JPA-provider -->
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- Verwijzing naar je Entity-klassen -->
        <class>domein.user.User</class>
        <class>domein.machine.Machine</class>
        <class>domein.machine.Maintenance</class>
        <class>domein.logging.LogEntry</class>
        <class>domein.notification.Notification</class>
        <class>domein.notification.UserNotification</class>
        <class>domein.site.Site</class>
        <class>domein.machine.report.Report</class>
        <!-- <class>domein.machine.report.Image</class> -->


        <properties>
<!--            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://vichogent.be:40058/SDP2_2425_DB_G02"/>-->
<!--            <property name="jakarta.persistence.jdbc.user" value="SDP2-2425-G02"/>-->
<!--            <property name="jakarta.persistence.jdbc.password" value="admin"/>-->
<!--            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>-->
            <property name="eclipselink.connection-pool.max" value="10"/>

            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/sys?serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.password" value="rootroot"/>

            <!-- EclipseLink specifieke instellingen -->
            <property name="eclipselink.target-database" value="MariaDB"/>
            <property name="eclipselink.logging.level" value="FINE"/>

            <!-- Schema generatie (update i.p.v. drop-and-create) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
